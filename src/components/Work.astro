---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { chapters, evolution } from '../data/site';
import { tableProps } from '../data/props';
import ChapterScreen from './ChapterScreen.astro';
import DayStill from './DayStill.astro';
import yoDesktop from '../assets/young-onion-woo-desktop.png';
import yoMobile from '../assets/young-onion-woo-mobile.png';
import gdffDesktop from '../assets/gd-farm-fresh-desktop.png';
import gdffMobile from '../assets/gd-farm-fresh-mobile.png';
import h360Desktop from '../assets/360homehealthcare-1440.png';
import h360Mobile from '../assets/360homehealthcare-390.png';
import fiomisDesktop from '../assets/fiomis-desktop.png';
import fiomisMobile from '../assets/fiomis-mobile.png';
import inventraDesktop from '../assets/inventra-desktop.png';
import inventraMobile from '../assets/inventra-mobile.png';
import aiDesktop from '../assets/ai-saas-desktop.png';
import aiMobile from '../assets/ai-saas-mobile.png';

const pad = (n: number) => String(n).padStart(2, '0');
/** Background hue per chapter for the subtle gradient shift. */
const hues = [28, 220, 36, 168, 200, 14];
const tex = async (src: ImageMetadata, width: number) => (await getImage({ src, width, format: 'webp', quality: 84 })).src;

/**
 * One desktop (1440×900, 16:10) + phone (390×844 @2x) pair per chapter, always of the SAME product: a real
 * capture where the site is public, an illustrative render (sample data) for unreleased work.
 * The pair is the 3D laptop/phone screens (gl-devices.ts) and, without the devices, the framed image + phone.
 */
type Screens = { desktop: ImageMetadata; mobile: ImageMetadata; host: string; note: string; live?: boolean; alt: string; phoneAlt: string };
const illus = 'Illustrative · sample data';
const screens: Record<string, Screens> = {
  'young-onion': {
    desktop: yoDesktop,
    mobile: yoMobile,
    host: 'youngonion.in',
    note: 'Woo store before the rebuild',
    alt: 'youngonion.in at desktop width: the WooCommerce stationery store (new arrivals) that the Astro storefront replaces',
    phoneAlt: 'youngonion.in on a phone: the WooCommerce store before the Astro rebuild',
  },
  zetstore: {
    desktop: gdffDesktop,
    mobile: gdffMobile,
    host: 'gdfarmfresh.com',
    note: 'GD Farm Fresh · on ZetStore',
    alt: 'gdfarmfresh.com at desktop width, a storefront running on the ZetStore API',
    phoneAlt: 'gdfarmfresh.com on a phone, a storefront running on the ZetStore API',
  },
  doc2home: {
    desktop: h360Desktop,
    mobile: h360Mobile,
    host: '360homehealthcare.in',
    note: 'Live site',
    live: true,
    alt: 'Screenshot of the live 360 Home Healthcare website (360homehealthcare.in) at desktop width',
    phoneAlt: 'The live 360 Home Healthcare website on a phone',
  },
  fiomis: {
    desktop: fiomisDesktop,
    mobile: fiomisMobile,
    host: 'fiomis — choose better',
    note: illus,
    alt: 'Illustrative Fiomis storefront home page with sample products and prices',
    phoneAlt: 'Illustrative Fiomis storefront on a phone with sample products and prices',
  },
  inventra: {
    desktop: inventraDesktop,
    mobile: inventraMobile,
    host: 'inventra / dashboard',
    note: illus,
    alt: 'Illustrative Inventra inventory dashboard with sample KPIs and purchase orders',
    phoneAlt: 'Illustrative Inventra dashboard on a phone with sample data',
  },
  'ai-saas': {
    desktop: aiDesktop,
    mobile: aiMobile,
    host: 'repurpose / new',
    note: illus,
    alt: 'Illustrative AI content repurposing app turning a blog post into an X thread and a LinkedIn carousel',
    phoneAlt: 'Illustrative AI content repurposing app on a phone with sample data',
  },
};
const texture = Object.fromEntries(
  await Promise.all(Object.entries(screens).map(async ([id, s]) => [id, { desktop: await tex(s.desktop, 1440), phone: await tex(s.mobile, 780) }])),
);
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="work-intro wrap">
    <p class="sec-head mono">[03] Selected work</p>
    <h2 id="work-title" class="display work-title" data-reveal>
      <span class="ln"><span>Six builds.</span></span>
      <span class="ln"><span><em>One evolving stack.</em></span></span>
    </h2>
    <p class="work-sub fade">
      From server-rendered storefronts to encrypted booking flows, commerce platforms and AI products — each build pushed
      the stack a step further. Where a site is public you see a real screenshot; unreleased work is shown as
      illustrative renders with sample data.
    </p>
    <ol class="evo mono" aria-label="Stack evolution">
      {
        evolution.map((s, i) => (
          <li class="fade" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <span class="evo-y">{s.when}</span>
            <span>{s.what}</span>
          </li>
        ))
      }
    </ol>
  </div>

  {
    chapters.map((c, i) => (
      <article
        class="chapter"
        id={c.id}
        aria-labelledby={`${c.id}-title`}
        style={`--hue:${hues[i % hues.length]}`}
        data-chapter
      >
        <div class="ch-stage" data-ch-stage>
          <span class="ch-num display" aria-hidden="true" data-ch-num>
            {pad(i + 1)}
          </span>
          <div class="ch-text">
            <p class="ch-index mono">
              <span class="accent">[{pad(i + 1)}]</span>
              <span class="label">/ {pad(chapters.length)}</span>
              <span class="label">— {c.kicker}</span>
            </p>
            <h3 id={`${c.id}-title`} class="display ch-title" data-reveal>
              <span class="ln">
                <span>{c.title}</span>
              </span>
            </h3>
            <dl class="ch-meta mono fade">
              <div>
                <dt class="label">Build</dt>
                <dd>{c.context}</dd>
              </div>
              <div>
                <dt class="label">Role</dt>
                <dd>{c.role}</dd>
              </div>
              <div>
                <dt class="label">Year</dt>
                <dd>{c.year}</dd>
              </div>
            </dl>
            <ul class="ch-stack fade" aria-label="Stack">
              {c.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <ol class="ch-outcomes">
              {c.outcomes.map((o, k) => (
                <li class="fade" style={`--d:${k * 0.08}s`} data-outcome>
                  <span class="mono label">{pad(k + 1)}</span>
                  <span>{o}</span>
                </li>
              ))}
            </ol>
            <p class="ch-link fade">
              {c.live && (
                <a class="pill pill--solid" href={c.live.href} target="_blank" rel="noopener">
                  {c.live.label} <span aria-hidden="true">↗</span>
                </a>
              )}
              <a
                class="pill"
                href={c.link.href}
                {...(c.link.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {c.link.label} <span aria-hidden="true">↗</span>
              </a>
              {c.link.note && <span class="mono label">{c.link.note}</span>}
            </p>
          </div>
          <div
            class:list={['ch-media', { 'ch-media--plinth': c.id === 'doc2home' }]}
            data-ch-media
            data-tex-desktop={texture[c.id].desktop}
            data-tex-phone={texture[c.id].phone}
          >
            {c.id === 'doc2home' && (
              <DayStill name="plinth" class="ch-plinth" sizes="(max-width: 1023px) 92vw, 52vw" alt={`${screens[c.id].alt}, on a laptop and a phone`} />
            )}
            <ChapterScreen
              src={screens[c.id].desktop}
              alt={screens[c.id].alt}
              host={screens[c.id].host}
              note={screens[c.id].note}
              live={screens[c.id].live}
            />
            {tableProps[c.id] && (
              <ul class="sr-only" aria-label="On the 3D table">
                {tableProps[c.id].map((p) => (
                  <li>{p.label}</li>
                ))}
              </ul>
            )}
            <figure class="ch-phone">
              <Image src={screens[c.id].mobile} alt={screens[c.id].phoneAlt} widths={[200, 390]} sizes="150px" loading="lazy" />
            </figure>
            <p class="ch-cap mono" aria-hidden="true">
              {screens[c.id].live && <i class="dot" />}
              {screens[c.id].host.includes('.') ? `${screens[c.id].host} · ` : ''}{screens[c.id].note}
            </p>
          </div>
          <div class="ch-progress" aria-hidden="true">
            <i data-ch-bar />
          </div>
        </div>
      </article>
    ))
  }
</section>

<style>
  .work {
    position: relative;
  }

  .work-intro {
    padding-top: clamp(96px, 12vw, 180px);
    padding-bottom: clamp(48px, 6vw, 96px);
  }

  .work-title {
    margin-top: clamp(36px, 5vw, 72px);
    font-size: var(--t-h2);
  }

  .work-title em {
    color: var(--muted);
  }

  .work-sub {
    margin-top: 28px;
    max-width: 38em;
    color: var(--muted);
    font-size: var(--t-lead);
  }

  /* Stack evolution: a stepped timeline. Each step draws its own slice of the rule (::before) and its dot
     (::after), so the rule runs behind every row however the grid wraps — no separator glyphs. */
  .evo {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    row-gap: 28px;
    margin-top: clamp(32px, 4vw, 56px);
    font-size: 11px;
  }

  .evo li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 24px 16px 0 0;
    line-height: 1.45;
  }

  .evo li::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line-strong);
  }

  .evo li::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--ink);
  }

  .evo li:last-child::after {
    border-color: var(--signal);
    background: var(--signal);
  }

  .evo-y {
    color: var(--muted);
  }

  @media (max-width: 1279px) {
    .evo {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .evo {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Narrow phones: one column on a vertical rule. */
  @media (max-width: 389px) {
    .evo {
      grid-template-columns: 1fr;
      row-gap: 0;
    }

    .evo li {
      padding: 0 0 16px 22px;
    }

    .evo li::before {
      top: 0;
      bottom: 0;
      left: 4px;
      right: auto;
      width: 1px;
      height: auto;
    }

    .evo li:first-child::before {
      top: 4px;
    }

    .evo li:last-child::before {
      bottom: auto;
      height: 4px;
    }

    .evo li::after {
      top: 2px;
    }
  }

  /* Static default: stacked, one chapter after another. */
  .chapter {
    position: relative;
    border-top: 1px solid var(--line);
  }

  .ch-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 4vw, 72px);
    align-items: center;
    padding: clamp(56px, 7vw, 96px) var(--g);
    overflow: hidden;
    background:
      radial-gradient(60% 75% at var(--gx, 72%) 38%, color-mix(in oklab, hsl(var(--hue) 40% 40%) 20%, var(--ink)), transparent 72%),
      var(--ink);
  }

  .ch-num {
    position: absolute;
    right: calc(var(--g) * 0.5);
    top: 0;
    font-size: clamp(160px, 26vw, 420px);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    pointer-events: none;
    z-index: 0;
  }

  .ch-text,
  .ch-media {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .ch-index {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ch-title {
    margin-top: 16px;
    font-size: clamp(40px, 4.4vw, 72px);
  }

  .ch-meta {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 8px 28px;
    margin-top: 24px;
    font-size: 11.5px;
  }

  .ch-meta dd {
    margin-top: 4px;
  }

  .ch-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }

  .ch-stack li {
    padding: 6px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font: 450 12px/1 var(--mono);
  }

  .ch-outcomes {
    margin-top: 22px;
    border-top: 1px solid var(--line);
  }

  .ch-outcomes li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.5;
  }

  .ch-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
  }

  .ch-media {
    perspective: 1600px;
  }

  .ch-cap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    font-size: 10.5px;
    color: var(--muted);
  }

  .ch-cap .dot {
    width: 6px;
    height: 6px;
  }

  /* Without the 3D devices (phones, tablets, no WebGL, reduced motion): a small phone frame over the screen. */
  .ch-phone {
    position: absolute;
    right: -2%;
    bottom: 4%;
    z-index: 2;
    width: min(24%, 160px);
    margin: 0;
    padding: 5px;
    border-radius: 22px;
    background: var(--device);
    box-shadow: 0 0 0 1px var(--line-strong), 0 30px 60px var(--shadow);
  }

  .ch-phone :global(img) {
    width: 100%;
    aspect-ratio: 390 / 844;
    object-fit: cover;
    object-position: top;
    border-radius: 17px;
  }

  /* 3D devices (gl-devices.ts): the shared canvas draws the laptop + phone over the media column with the
     same two images as screen textures, so the DOM frame and phone fade out (they stay in the accessibility
     tree) and the caption moves above the devices. */
  :global(html.gl-dev) .ch-media {
    perspective: none;
  }

  :global(html.gl-dev) .ch-media :global(.ch-screen),
  :global(html.gl-dev) .ch-phone {
    opacity: 0;
  }

  :global(html.gl-dev) .ch-cap {
    position: absolute;
    left: 0;
    top: -40px;
    margin: 0;
    color: var(--bone);
    font-size: 11px;
  }

  /* 360 Home Healthcare without the live devices: the pre-rendered laptop + phone plinth (per theme). */
  .ch-media :global(.ch-plinth) {
    --still-fit: contain;
    aspect-ratio: 1016 / 791;
  }

  :global(html:not(.gl-dev)) .ch-media--plinth :global(.ch-screen),
  :global(html:not(.gl-dev)) .ch-media--plinth .ch-phone,
  :global(html.gl-dev) .ch-media :global(.ch-plinth) {
    display: none;
  }

  /* Hovered table prop's label (gl-devices.ts): a fixed layer above the lifted canvas; aria-hidden — the
     sr-only list in each chapter's media column carries the same labels. */
  :global(.gl-prop-tags) {
    position: fixed;
    inset: 0;
    z-index: 7;
    pointer-events: none;
  }

  :global(.gl-tag--prop) {
    translate: -50% -100%;
  }

  :global(.gl-tag--prop.on) {
    opacity: 1;
  }

  .ch-progress {
    position: absolute;
    left: var(--g);
    right: var(--g);
    bottom: 22px;
    height: 1px;
    background: var(--line);
    display: none;
  }

  .ch-progress i {
    display: block;
    height: 100%;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* Pinned, scrubbed chapters on large screens with enough height. Each chapter after the first is pulled
     up so its sticky stage overlaps the previous one, then revealed with a clip-path wipe (--wipe 1 → 0). */
  @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) and (min-height: 700px) {
    :global(html.motion:not(.boot-fail)) .chapter {
      height: 250vh;
      border-top: 0;
    }

    :global(html.motion:not(.boot-fail)) .chapter + .chapter {
      margin-top: -150vh;
    }

    :global(html.motion:not(.boot-fail)) .chapter:last-child {
      height: 200vh;
    }

    :global(html.motion:not(.boot-fail)) .ch-stage {
      position: sticky;
      top: 0;
      height: 100vh;
      padding-top: calc(var(--header-h) + 12px);
      padding-bottom: 48px;
      border-top: 1px solid var(--line);
    }

    :global(html.motion:not(.boot-fail)) .chapter + .chapter .ch-stage {
      clip-path: inset(calc(var(--wipe, 0) * 100%) 0 0 0);
    }

    :global(html.motion:not(.boot-fail)) .chapter + .chapter .ch-stage::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: calc(var(--wipe, 0) * 100%);
      z-index: 3;
      height: 1px;
      background: var(--signal);
      opacity: min(1, calc(var(--wipe, 0) * 12));
      pointer-events: none;
    }

    :global(html.motion:not(.boot-fail)) .ch-progress {
      display: block;
    }
  }

  @media (max-width: 1279px) {
    .ch-outcomes li {
      font-size: 14px;
      padding: 10px 0;
    }
  }

  @media (max-width: 1023px) {
    .ch-stage {
      grid-template-columns: 1fr;
    }

    .ch-media {
      order: -1;
    }
  }

  @media (max-width: 767px) {
    .ch-meta {
      grid-template-columns: 1fr 1fr;
    }

    .ch-outcomes li {
      grid-template-columns: 26px 1fr;
      gap: 8px;
    }
  }
</style>
