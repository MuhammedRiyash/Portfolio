---
import { bio } from '../data/site';

const statement = [
  { t: 'I build the storefront you see' },
  { t: '— and the commerce engine' },
  { t: 'you don’t.', em: true },
];
const split = (s: string) => s.split(' ');
---

<section class="statement wrap" id="about" aria-labelledby="about-title">
  <p class="sec-head mono">[02] About</p>
  <h2 id="about-title" class="display statement-line" data-words>
    {
      statement.map((line) => (
        <span class="st-line">
          {split(line.t).map((w) => (
            <>
              <span class={line.em ? 'w w-em' : 'w'}>{w}</span>{' '}
            </>
          ))}
        </span>
      ))
    }
  </h2>

  <div class="statement-grid">
    <dl class="facts mono">
      <div class="fade"><dt class="label">Now</dt><dd>Senior full-stack developer, Bengaluru</dd></div>
      <div class="fade" style="--d:.08s"><dt class="label">Shipping</dt><dd>Web builds since Sep 2023</dd></div>
      <div class="fade" style="--d:.16s"><dt class="label">Started</dt><dd>React + Laravel, 2023</dd></div>
      <div class="fade" style="--d:.24s"><dt class="label">Studying</dt><dd>MCA, SRM University (2027)</dd></div>
    </dl>
    <div class="bio">
      {bio.map((p, i) => <p class="fade" style={`--d:${i * 0.1}s`}>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .statement {
    position: relative;
    padding-top: clamp(96px, 14vw, 200px);
    padding-bottom: clamp(80px, 10vw, 160px);
    background: var(--ink);
  }

  .statement-line {
    margin-top: clamp(36px, 5vw, 72px);
    font-size: var(--t-h2);
    line-height: 1;
    max-width: 16em;
  }

  .st-line:nth-child(2) {
    padding-left: clamp(0px, 8vw, 160px);
  }

  .w-em {
    font-weight: 620;
    color: var(--signal);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.boot-fail)) .w {
      opacity: var(--o, 0.16);
    }
  }

  .statement-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(56px, 8vw, 120px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .facts {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .facts div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
  }

  .bio {
    display: grid;
    gap: 1.1em;
    font-size: var(--t-lead);
    line-height: 1.5;
    max-width: 40em;
    color: var(--bone);
  }

  .bio p + p {
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .statement-grid {
      grid-template-columns: 1fr;
    }

    .st-line:nth-child(2) {
      padding-left: 0;
    }
  }
</style>
