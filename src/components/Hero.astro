---
import DayStill from './DayStill.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div
    class="hero-stage"
    role="img"
    aria-label="Illustrated miniature: a developer's desk at 09:00 with a laptop typing code, a phone, coffee and small AI agent bots; below it, a cut-away city block whose layers are the product stack."
    data-hero-stage
  >
    <DayStill name="desk-am" class="hero-still" />
    <div class="hero-shade" aria-hidden="true"></div>
  </div>

  <div class="hero-copy">
    <p class="mono label hero-kicker">[00] Muhammed Riyash J — Portfolio</p>
    <h1 id="hero-title" class="display hero-title" data-reveal data-hero-title>
      <span class="ln"><span>From first pixel</span></span>
      <span class="ln"><span>to final <em class="accent">payment.</em></span></span>
    </h1>
    <p class="hero-sub fade" style="--d: .35s">
      Senior full-stack developer in Bengaluru — headless storefronts, commerce platforms and payment flows.
    </p>
    <div class="hero-actions">
      <a class="pill pill--solid" href="#work" data-magnetic>See the work</a>
      <a class="pill" href="/cv/">Quick view <span class="mono label">/cv</span></a>
    </div>
  </div>

  <dl class="hero-legend mono" aria-label="Figure legend" data-day-legend>
    <div><dt>Fig. 01</dt><dd data-legend-act>09:00 · The desk</dd></div>
    <div><dt>Agents</dt><dd>Writing tests, reviewing PRs</dd></div>
    <div><dt>Stack</dt><dd>Storefront → API → ledger → vault → CI</dd></div>
    <div><dt><i class="dot" aria-hidden="true"></i>Live</dt><dd>Scroll moves the clock</dd></div>
  </dl>

  <div class="gl-tags" data-agent-tags aria-hidden="true"></div>
  <ul class="sr-only">
    <li>AI agent: writing Playwright tests</li>
    <li>AI agent: summarising the PR</li>
    <li>AI agent: checking GST on shipping</li>
    <li>AI agent: reviewing the webhook handler</li>
  </ul>

  <ul class="hero-meta mono">
    <li>Bengaluru, India</li>
    <li>Headless commerce · Fintech</li>
    <li><span class="dot dot--pulse" aria-hidden="true"></span>Open to senior full-stack roles</li>
    <li class="hero-scroll"><a href="#about">Scroll <span aria-hidden="true">↓</span></a></li>
  </ul>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: 1fr auto auto;
    padding: 0 var(--g);
    isolation: isolate;
  }

  @supports (height: 100svh) {
    .hero {
      min-height: max(600px, 100svh);
    }
  }

  .hero-stage {
    position: absolute;
    inset: 8px;
    border-radius: var(--r);
    overflow: hidden;
    background:
      radial-gradient(80% 70% at 70% 30%, color-mix(in srgb, var(--bone) 7%, var(--ink)) 0%, transparent 70%),
      var(--ink);
    z-index: -1;
  }

  /* Themed still of the 09:00 desk (reduced motion, no WebGL, until the scene boots). */
  .hero-stage :global(.hero-still) {
    position: absolute;
    inset: 0;
    --still-pos: 72% 42%;
    transition: opacity 0.9s var(--ease-out);
  }

  /* The live scene is the shared fixed canvas behind <main>: the frame turns transparent. */
  :global(html.gl-live) .hero-stage {
    background: transparent;
  }

  :global(html.gl-live) .hero-stage :global(.hero-still) {
    opacity: 0;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    /* edge shading only: the copy carries its own scrim, so the desk (right) stays bright and legible */
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--ink) 55%, transparent) 0%, transparent 16%),
      linear-gradient(0deg, color-mix(in srgb, var(--ink) 88%, transparent) 0%, color-mix(in srgb, var(--ink) 24%, transparent) 24%, transparent 40%),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 72%, transparent) 0%, color-mix(in srgb, var(--ink) 26%, transparent) 40%, transparent 58%);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 2;
    padding-top: calc(var(--header-h) + 24px);
    padding-bottom: clamp(28px, 4vw, 48px);
    max-width: 1180px;
  }

  /* Scrim: keeps the copy (small mono labels included) ≥ 4.5:1 over whatever the 3D scene shows. */
  .hero-copy::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: calc(var(--header-h) - 64px) -18% -8% calc(var(--g) * -1);
    background: radial-gradient(
      farthest-side at 34% 60%,
      color-mix(in srgb, var(--ink) 88%, transparent) 0%,
      color-mix(in srgb, var(--ink) 78%, transparent) 70%,
      transparent 100%
    );
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .hero-copy::before {
      inset: calc(var(--header-h) - 24px) calc(var(--g) * -1) -8%;
      background: linear-gradient(
        0deg,
        color-mix(in srgb, var(--ink) 88%, transparent) 0%,
        color-mix(in srgb, var(--ink) 80%, transparent) 88%,
        transparent 100%
      );
    }
  }

  /* Small text over the scene: a lifted muted (between --muted and --bone) for AA on the scrims. */
  .hero {
    --hero-soft: color-mix(in srgb, var(--bone) 74%, var(--ink));
  }

  .hero-kicker {
    margin-bottom: clamp(18px, 2vw, 28px);
    color: var(--hero-soft);
  }

  .hero-title {
    font-size: var(--t-display);
    line-height: 0.93;
    max-width: 11.5em;
  }

  .hero-title .ln > span {
    text-wrap: balance;
  }

  .hero-title em {
    color: var(--signal);
  }

  .hero-sub {
    max-width: 34em;
    margin-top: clamp(16px, 1.8vw, 24px);
    color: var(--hero-soft);
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.45;
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .hero-legend {
    grid-column: 2;
    grid-row: 2;
    align-self: end;
    display: grid;
    gap: 6px;
    margin-bottom: clamp(28px, 4vw, 48px);
    padding: 6px 14px 12px;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--ink) 78%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-size: 11.5px;
    color: var(--hero-soft);
    min-width: 300px;
  }

  .hero-legend div:first-child {
    border-top: 0;
  }

  .hero-legend div {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 12px;
    padding-top: 6px;
    border-top: 1px solid var(--line);
  }

  .hero-legend dt {
    color: var(--bone);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hero-legend .dot {
    width: 6px;
    height: 6px;
  }

  .hero-meta {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    padding: 16px 0 calc(16px + 8px);
    border-top: 1px solid var(--line);
    color: var(--bone);
    font-size: 11.5px;
  }

  /* WorldBuilder's 3D-anchored agent tags; positioned by gl code, never part of the grid flow. */
  .gl-tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-meta li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
  }

  .hero-scroll {
    justify-content: flex-end;
  }

  .hero-scroll a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-scroll span {
      display: inline-block;
      animation: nudge 2.4s var(--ease) infinite;
    }
  }

  @keyframes nudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  @media (max-width: 1199px) {
    .hero-legend {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .hero-stage {
      inset: 0;
      border-radius: 0;
    }

    .hero-shade {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--ink) 50%, transparent) 0%, transparent 20%),
        linear-gradient(0deg, color-mix(in srgb, var(--ink) 96%, transparent) 0%, color-mix(in srgb, var(--ink) 55%, transparent) 42%, transparent 64%);
    }

    .hero-meta {
      grid-template-columns: 1fr 1fr;
      row-gap: 4px;
    }

    .hero-title {
      font-size: clamp(36px, 10.2vw, 64px);
    }
  }
</style>
