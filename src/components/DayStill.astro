---
/**
 * A still of "A Day in the Stack", rendered from the live scene per theme (public/stills/<theme>/<name>-<w>.webp,
 * see AGENTS.md → "Re-render the stills"). Shown where the WebGL canvas is not: reduced motion, no WebGL,
 * before the scene boots, and (plinth) wherever the 3D devices are off. Only the image of the current theme
 * is displayed — the others are display:none + lazy, so they are never fetched.
 */
interface Props {
  name: 'desk-am' | 'city' | 'plinth' | 'street' | 'desk-pm';
  alt?: string;
  class?: string;
  /** CSS `sizes` for the 800/1600 w candidates */
  sizes?: string;
}

const { name, alt = '', class: cls, sizes = '100vw' } = Astro.props;
const themes = ['noir', 'midnight', 'forest'] as const;
---

<div class:list={['day-still', cls]} data-still={name}>
  {
    themes.map((t) => (
      <img
        data-still-theme={t}
        src={`/stills/${t}/${name}-1600.webp`}
        srcset={`/stills/${t}/${name}-800.webp 800w, /stills/${t}/${name}-1600.webp 1600w`}
        sizes={sizes}
        alt={alt}
        width="1600"
        height="1000"
        loading="lazy"
        decoding="async"
      />
    ))
  }
</div>

<style>
  .day-still img {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: var(--still-fit, cover);
    object-position: var(--still-pos, 50% 50%);
  }

  .day-still img[data-still-theme='noir'],
  :global(:root[data-theme='midnight']) .day-still img[data-still-theme='midnight'],
  :global(:root[data-theme='forest']) .day-still img[data-still-theme='forest'] {
    display: block;
  }

  :global(:root[data-theme='midnight']) .day-still img[data-still-theme='noir'],
  :global(:root[data-theme='forest']) .day-still img[data-still-theme='noir'] {
    display: none;
  }
</style>
