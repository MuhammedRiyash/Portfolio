---
import { person } from '../data/site';
import ThemeSwitch from './ThemeSwitch.astro';

const links = [
  { n: '01', label: 'Product', href: '#product' },
  { n: '02', label: 'About', href: '#about' },
  { n: '03', label: 'Work', href: '#work' },
  { n: '04', label: 'Experience', href: '#experience' },
  { n: '05', label: 'Toolbox', href: '#toolbox' },
  { n: '06', label: 'Contact', href: '#contact' },
];
---

<header class="chrome" id="chrome" data-chrome>
  <a class="wm" href="#top" aria-label="Muhammed Riyash J — back to top">
    <span class="wm-mark" aria-hidden="true">MD</span>
    <span class="wm-name">MD Riyash</span>
  </a>

  <div class="ticker mono" aria-hidden="true" data-ticker>
    <span class="ticker-item" data-clock>Bengaluru · IST</span>
  </div>

  <div class="chrome-right">
    <ThemeSwitch compact class="chrome-theme" />
    <a class="talk" href="#contact" data-magnetic>
      <span class="dot dot--pulse" aria-hidden="true"></span>
      <span>Let’s talk</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <svg class="ring" viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="22.5" pathLength="100" data-ring></circle>
      </svg>
      <span class="menu-dots" aria-hidden="true"><i></i><i></i></span>
      <span class="sr-only">Menu</span>
    </button>
  </div>
</header>

<nav id="menu" class="menu" aria-label="Main" data-menu>
  <ul class="menu-links">
    {
      links.map((l) => (
        <li>
          <a href={l.href} data-menu-link>
            <span class="mono label">[{l.n}]</span>
            <span class="menu-label">{l.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="menu-foot">
    <a class="pill pill--solid" href="/cv/">Quick view — CV</a>
    <a class="pill" href={person.resume} download>Download CV</a>
  </div>
  <div class="menu-theme">
    <p class="mono label" aria-hidden="true">Theme</p>
    <ThemeSwitch />
  </div>
  <ul class="menu-social mono">
    <li><a class="ulink" href={`mailto:${person.email}`}>Email</a></li>
    <li><a class="ulink" href={person.whatsapp} rel="noopener" target="_blank">WhatsApp</a></li>
    <li><a class="ulink" href={person.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>
    <li><a class="ulink" href={person.github} rel="noopener" target="_blank">GitHub</a></li>
  </ul>
</nav>

<div class="gauge mono" aria-hidden="true" data-gauge>
  <span data-gauge-num>000</span>
  <span class="gauge-track"><i data-gauge-bar></i></span>
</div>

<div class="cursor" aria-hidden="true" data-cursor-el><span data-cursor-label></span></div>

<style>
  .chrome {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 0 calc(var(--g) * 0.6);
    pointer-events: none;
    transition: transform 0.7s var(--ease);
  }

  .chrome > * {
    pointer-events: auto;
  }

  .chrome:global(.hid) {
    transform: translateY(-130%);
  }

  .wm,
  .ticker,
  .menu-btn {
    background: var(--glass);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid var(--line);
  }

  .wm {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 16px 0 6px;
    border-radius: 999px;
    font: 500 14.5px/1 var(--sans);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .wm-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bone);
    color: var(--ink);
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.02em;
  }

  .ticker {
    position: relative;
    height: 36px;
    min-width: 270px;
    border-radius: 999px;
    overflow: hidden;
    color: var(--bone);
    font-size: 11.5px;
  }

  .ticker :global(.ticker-item) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    padding: 0 16px;
    transition:
      transform 0.8s var(--ease),
      opacity 0.8s var(--ease);
  }

  .chrome-right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .talk {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--bone);
    color: var(--ink);
    --signal: var(--signal-on-bone);
    font: 500 14.5px/1 var(--sans);
    white-space: nowrap;
    transition:
      background-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out);
  }

  .talk:hover {
    --signal: inherit;
    background: var(--signal);
    color: var(--signal-ink);
  }

  /* The menu needs JS; without it the footer index and in-page links still work. */
  :global(html:not(.js)) .menu-btn {
    display: none;
  }

  .menu-btn {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }

  .ring {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    transform: rotate(-90deg);
    pointer-events: none;
  }

  .ring circle {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.5;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .menu-dots {
    display: grid;
    gap: 5px;
  }

  .menu-dots i {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--bone);
    transition: transform 0.5s var(--ease);
  }

  .menu-btn[aria-expanded='true'] .menu-dots i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .menu-dots i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Menu card */
  .menu {
    position: fixed;
    z-index: 49;
    top: calc(var(--header-h) + 4px);
    right: calc(var(--g) * 0.6);
    width: min(440px, calc(100vw - var(--g) * 1.2));
    max-height: calc(100svh - var(--header-h) - 20px);
    overflow: auto;
    padding: 22px 24px 24px;
    border-radius: var(--r);
    background: var(--ink-2);
    border: 1px solid var(--line-strong);
    box-shadow: 0 30px 80px var(--shadow);
    transform-origin: 100% 0;
    transform: scale(0.94) translateY(-8px);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.5s var(--ease),
      opacity 0.35s var(--ease-out),
      visibility 0s linear 0.5s;
  }

  .menu:global(.open) {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition:
      transform 0.5s var(--ease),
      opacity 0.35s var(--ease-out),
      visibility 0s;
  }

  .menu-links li + li {
    border-top: 1px solid var(--line);
  }

  .menu-links a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    transition: padding 0.5s var(--ease);
  }

  .menu-links a:hover {
    padding-left: 10px;
  }

  .menu-label {
    font: 540 clamp(30px, 3.8vw, 40px) / 1 var(--display);
    letter-spacing: -0.04em;
  }

  .menu-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .menu-theme {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .menu-social {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 20px;
    color: var(--muted);
  }

  .menu-social a {
    display: inline-block;
    padding: 15px 0;
    color: var(--bone);
  }

  /* Gauge */
  .gauge {
    position: fixed;
    right: calc(var(--g) * 0.6);
    bottom: 22px;
    z-index: 40;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    color: var(--bone);
    font-size: 11.5px;
    padding: 10px 12px;
    border-radius: 999px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }

  .gauge:global(.on) {
    opacity: 1;
  }

  .gauge-track {
    width: 2px;
    height: 64px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .gauge-track i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--signal);
    transform-origin: 50% 0;
    transform: scaleY(0);
  }

  /* The reel's riding words end in the bottom-right corner, under the gauge: step aside while it plays. */
  :global(html:has(.reel.live)) .gauge {
    opacity: 0;
  }

  /* Cursor */
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 95;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    transform: translate3d(-100px, -100px, 0);
    border-radius: 50%;
    background: var(--signal);
    /* Keeps the dot visible on --bone fills, where a light accent (Forest) would vanish. */
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 55%, transparent);
    pointer-events: none;
    display: none;
    place-items: center;
    transition:
      width 0.45s var(--ease),
      height 0.45s var(--ease),
      margin 0.45s var(--ease),
      opacity 0.3s;
  }

  .cursor :global(span) {
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--signal-ink);
    opacity: 0;
    transition: opacity 0.3s;
    white-space: nowrap;
  }

  :global(html.has-cursor) .cursor {
    display: grid;
  }

  .cursor:global(.hover) {
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
  }

  .cursor:global(.label) {
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
  }

  .cursor:global(.label) :global(span) {
    opacity: 1;
  }

  .cursor:global(.away) {
    opacity: 0;
  }

  @media (max-width: 1023px) {
    .ticker {
      display: none;
    }

    .chrome {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 767px) {
    /* Phones: the switcher lives in the menu only. */
    .chrome-right :global(.chrome-theme) {
      display: none;
    }

    .gauge {
      display: none;
    }
  }

  @media (max-width: 479px) {
    .wm-name {
      display: none;
    }

    .wm {
      padding: 0 6px;
    }

    .talk {
      padding: 0 14px;
    }
  }
</style>
