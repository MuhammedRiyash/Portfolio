---
import { person } from '../data/site';
import DayStill from './DayStill.astro';

const words = ['Let’s', 'build', 'it.'];
let ci = 0;
const roll = words.map((w, wi) => ({
  em: wi === words.length - 1,
  chars: [...w].map((c) => ({ c, d: ci++ * 18 })),
}));

const contacts = [
  { k: 'Email', v: person.email, href: `mailto:${person.email}` },
  { k: 'WhatsApp', v: person.phone, href: person.whatsapp, ext: true },
  { k: 'LinkedIn', v: 'in/muhammedriyash', href: person.linkedin, ext: true },
  { k: 'GitHub', v: 'MuhammedRiyash', href: person.github, ext: true },
  { k: 'Download CV', v: 'PDF, 1 page', href: person.resume, download: true },
  { k: 'Quick view', v: 'Printable CV', href: '/cv/' },
];
---

<section class="fin wrap" id="contact" aria-labelledby="fin-title">
  <p class="sec-head mono">[06] Contact</p>
  <h2 id="fin-title" class="fin-title display">
    <a class="roll" href={`mailto:${person.email}`} aria-label="Let’s build it — email Muhammed" data-cursor="Email">
      {
        roll.map((w) => (
          <>
            <span class={w.em ? 'wd em' : 'wd'} aria-hidden="true">
              {w.chars.map(({ c, d }) => (
                <span class="ch">
                  <span data-c={c} style={`transition-delay:${d}ms`}>
                    {c}
                  </span>
                </span>
              ))}
            </span>{' '}
          </>
        ))
      }
    </a>
  </h2>
  <p class="fin-sub fade">
    Hiring for a senior full-stack role, or want to talk about one? Tell me about the team and what you’re shipping.
    Based in Bengaluru, open to teams anywhere.
  </p>
  <p class="fin-cta fade">
    <a class="pill pill--solid" href={person.resume} download data-magnetic><span class="dot" aria-hidden="true"></span>Download CV</a>
    <a class="pill" href="/cv/">Quick view — CV</a>
    <a class="fin-fl mono ulink" href="https://muhammedriyash.github.io/Website/" target="_blank" rel="noopener">Web development services → muhammedriyash.github.io/Website</a>
  </p>

  <div class="fin-grid">
    <ul class="fin-links">
      {
        contacts.map((c) => (
          <li>
            <a
              href={c.href}
              {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})}
              {...(c.download ? { download: '' } : {})}
            >
              <span class="mono label">{c.k}</span>
              <span class="fl-v">{c.v}</span>
              <span class="fl-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <form class="form" action={person.formspree} method="POST" data-form novalidate>
      <p class="mono label form-title">Or send a brief</p>
      <div class="field">
        <label for="f-name" class="mono">Name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="f-email" class="mono">Email</label>
        <input id="f-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="f-msg" class="mono">What are you building?</label>
        <textarea id="f-msg" name="message" rows="4" required></textarea>
      </div>
      <div class="hp" aria-hidden="true">
        <label for="f-gotcha">Leave this field empty</label>
        <input id="f-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="_subject" value="Portfolio enquiry" />
      <div class="form-foot">
        <button class="pill pill--solid" type="submit" data-submit data-magnetic>
          <span class="dot" aria-hidden="true"></span>Send message
        </button>
        <p class="form-status" role="status" aria-live="polite" data-status></p>
      </div>
    </form>
  </div>
  <DayStill name="desk-pm" class="fin-still" sizes="(max-width: 1023px) 100vw, 80vw" />
</section>

<style>
  /* 23:30, the desk at night: the still where the live scene (behind the footer flood) is not running. */
  .fin :global(.fin-still) {
    margin-top: clamp(48px, 6vw, 96px);
    aspect-ratio: 16 / 10;
    border-radius: var(--r);
    overflow: hidden;
  }

  :global(html.gl-live) .fin :global(.fin-still) {
    display: none;
  }

  .fin {
    padding-top: clamp(96px, 12vw, 180px);
    padding-bottom: clamp(80px, 10vw, 140px);
  }

  .fin-title {
    margin-top: clamp(36px, 5vw, 72px);
    font-size: clamp(56px, 11vw, 190px);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .roll {
    display: inline;
  }

  .wd {
    display: inline-block;
    white-space: nowrap;
  }

  .ch {
    display: inline-block;
    height: 1em;
    line-height: 1;
    overflow: hidden;
  }

  .ch > span {
    position: relative;
    display: block;
    transition: transform 0.7s var(--ease);
  }

  .ch > span::after {
    content: attr(data-c);
    position: absolute;
    left: 0;
    top: 100%;
    color: var(--signal);
  }

  .wd.em {
    color: var(--signal);
    padding-right: 0.04em;
  }

  .wd.em .ch > span::after {
    color: var(--bone);
  }

  .roll:hover .ch > span,
  .roll:focus-visible .ch > span {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .ch > span {
      transition: none;
    }

    .roll:hover .ch > span {
      transform: none;
    }

    .roll:hover {
      color: var(--signal);
    }
  }

  .fin-sub {
    max-width: 34em;
    margin-top: 28px;
    font-size: var(--t-lead);
    color: var(--muted);
  }

  .fin-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 28px;
  }

  .fin-fl {
    display: inline-block;
    padding: 14px 0;
    color: var(--muted);
    font-size: 11.5px;
    overflow-wrap: anywhere;
  }

  .fin-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(48px, 6vw, 96px);
  }

  .fin-links {
    border-top: 1px solid var(--line);
  }

  .fin-links li {
    border-bottom: 1px solid var(--line);
  }

  .fin-links a {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 8px 0;
    transition: padding 0.5s var(--ease);
  }

  .fl-v {
    font: 520 clamp(20px, 1.8vw, 26px) / 1.15 var(--display);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .fl-arrow {
    transition: transform 0.5s var(--ease);
  }

  .fin-links a:hover {
    padding-left: 10px;
  }

  .fin-links a:hover .fl-arrow {
    transform: rotate(45deg);
    color: var(--signal);
  }

  .form {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .form-title {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field label {
    color: var(--muted);
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 10px 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    font-size: 18px;
    transition: border-color 0.3s;
  }

  .field textarea {
    resize: vertical;
    min-height: 110px;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--signal);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    box-shadow: 0 1px 0 0 var(--signal);
  }

  .field :global([aria-invalid='true']) {
    border-bottom-color: var(--signal);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .form-status {
    font-size: 14px;
    color: var(--muted);
  }

  .form-status:global(.ok) {
    color: var(--bone);
  }

  .form-status:global(.err) {
    color: var(--signal-text);
  }

  @media (max-width: 1023px) {
    .fin-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .fin-links a {
      grid-template-columns: 1fr auto;
      gap: 2px 12px;
    }

    .fin-links .mono {
      grid-column: 1 / -1;
    }

    .fin-links .fl-v {
      grid-column: 1;
    }

  }
</style>
