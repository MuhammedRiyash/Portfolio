---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { person, skills } from '../data/site';
import { THEMES, THEME_KEY, DEFAULT_THEME } from '../data/themes';

interface Props {
  title: string;
  /** Social-card title (OG/Twitter); defaults to `title`. */
  ogTitle?: string;
  description: string;
  /** Path relative to the site root, e.g. "/" or "/cv/". */
  path: string;
  /** Adds the cinematic boot classes (loader, WebGL probe, watchdog). */
  cinematic?: boolean;
  bodyClass?: string;
}

const { title, ogTitle = title, description, path, cinematic = false, bodyClass } = Astro.props;
const site = Astro.site ?? new URL(person.url);
const canonical = new URL(path, site).href;
const ogImage = new URL('/og.png', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  alternateName: 'Muhammed Riyash',
  jobTitle: person.title,
  url: person.url,
  image: new URL('/og.png', site).href,
  email: `mailto:${person.email}`,
  telephone: person.phone.replace(/\s/g, ''),
  address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'SRM University, Sikkim' },
    { '@type': 'CollegeOrUniversity', name: 'RDB College of Arts and Science' },
  ],
  knowsAbout: skills.flatMap((s) => s.items).slice(0, 30),
  knowsLanguage: ['English', 'Tamil', 'Arabic'],
  sameAs: [person.linkedin, person.github],
};
---

<!doctype html>
<html lang="en" class={cinematic ? 'cine' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={person.name} />
    <meta name="theme-color" content={THEMES[0].ground} />
    <meta name="color-scheme" content="dark" />
    <script is:inline define:vars={{ themes: THEMES, key: THEME_KEY, fallback: DEFAULT_THEME }}>
      // Pre-paint theme: the stored choice, else Noir. Unknown values (e.g. the retired `paper`) migrate
      // to Noir. Runs before first paint, so there is no flash.
      var d = document.documentElement;
      var t = null;
      try { t = localStorage.getItem(key); } catch (e) {}
      if (!themes.some(function (x) { return x.name === t; })) {
        if (t !== null) { try { localStorage.setItem(key, fallback); } catch (e) {} }
        t = fallback;
      }
      d.dataset.theme = t;
      d.classList.add('theme-js');
      var m = document.querySelector('meta[name="theme-color"]');
      var g = themes.filter(function (x) { return x.name === t; })[0];
      if (m && g) m.setAttribute('content', g.ground);
    </script>
    {
      cinematic && (
        <script is:inline>
          (function () {
            var d = document.documentElement;
            d.classList.add('js');
            var rm = false;
            var seen = false;
            try { rm = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
            try { seen = sessionStorage.getItem('mr:intro') === '1'; } catch (e) {}
            if (rm || seen) d.classList.add('skip-intro');
            if (!rm) d.classList.add('motion');
            try {
              var c = document.createElement('canvas');
              if (!c.getContext('webgl2')) d.classList.add('nogl');
            } catch (e) {
              d.classList.add('nogl');
            }
            window.__lift = function (why) {
              if (window.__lifted) return;
              window.__lifted = why || 'ok';
              d.classList.add('intro-done');
            };
            setTimeout(function () {
              if (window.__lifted) return;
              d.classList.add('boot-fail');
              window.__lift('watchdog');
            }, 8000);
          })();
        </script>
      )
    }
    {cinematic && (
      <noscript>
        <style>
          #loader { display: none !important; }
        </style>
      </noscript>
    )}
    <Font cssVariable="--font-display" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Muhammed Riyash J" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Muhammed Riyash J — Senior Full-Stack Developer, Bengaluru" />
    <meta property="og:locale" content="en_IN" />
    <meta property="profile:first_name" content="Muhammed Riyash" />
    <meta property="profile:last_name" content="J" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
